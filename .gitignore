renders/ep01_flow_clips/
renders/ep01_v5_7d_9x16_clips/
renders/opener_v5_7d_16x9_clips/

# Never commit OAuth tokens or API secrets
*token*.json
*client_secret*.json
.env

# ---- Storage policy: Google Drive is the central repository for ALL media & build artifacts ----
